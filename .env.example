# Copy this file to .env and fill in real values. .env is gitignored - never commit it.
# See DEPLOY.md for how each of these is used in a production deployment.

# MySQL connection string. For the managed production DB this includes
# ssl_ca= pointing at the CA cert mounted into the container (see DEPLOY.md) -
# the path is /app/ca-certificate.crt inside every container, regardless of
# where the file lives on the host.
DATABASE_URL=mysql+pymysql://user:password@host:25060/production?ssl_ca=/app/ca-certificate.crt

# Noise and Weather API credentials, used only by the `ingest` service/cron job.
NW_USERNAME=
NW_PASSWORD=
NW_BASE_URL=https://api.noiseandweather.com/v1

# Comma-separated noise_site_ids to scope ingestion to. Leave empty/unset to
# ingest every locally-known, non-ignored site.
INGEST_SITE_IDS=

# Flask session signing key. Generate a real one for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Never reuse the dev default across environments.
SECRET_KEY=dev-secret-key-change-me

# Set to true once the app is served over HTTPS (adds the Secure flag to the
# session cookie). Leave false for local/plain-HTTP development.
SESSION_COOKIE_SECURE=false

# Generic fallback per-site cap on ProcessedReadingRepository.list_readings,
# used only if some future caller doesn't pass per_site_limit explicitly -
# every current caller (Charts, Trends) passes its own explicit cap below, so
# this normally has no effect. Defaults to 3000 if unset.
# PER_SITE_READING_LIMIT=3000

# Per-site cap for the Charts tab specifically (figures + raw table) - Charts
# is expected to show a site's full history, not a trend-analysis sample, so
# this defaults far higher than the generic fallback above. Still a hard
# backstop against a genuinely unbounded query, not truly unlimited - see
# chart_service.py's OOM-incident history for why that matters. Defaults to
# 100000 if unset.
# CHARTS_PER_SITE_LIMIT=100000

# Per-site cap for the Trends tab (Rain-rate-vs-level, Age-effects). The old
# 3000-row default silently kept only each site's most-recent 3000 rows by
# datetime - fine in general, but actively wrong for Age-effects, whose x-axis
# (reconductoring_age) is itself time-correlated: for a long-lived conductor,
# "most recent N rows" only covers the tail of the age range, truncating the
# visible time series. Defaults to 100000 if unset.
# TRENDS_PER_SITE_LIMIT=100000
